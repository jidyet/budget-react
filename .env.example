# Copy this file to .env and fill values (do NOT commit real keys)
# Required from Firebase Console -> Project settings -> Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_MEASUREMENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_BILLING_API_URL=
VITE_STRIPE_CHECKOUT_URL=
VITE_STRIPE_CHECKOUT_URL_MONTHLY=
VITE_STRIPE_CHECKOUT_URL_YEARLY=
VITE_STRIPE_PORTAL_URL=
VITE_STRIPE_PRICE_PREMIUM_MONTHLY=
VITE_STRIPE_PRICE_PREMIUM_YEARLY=
VITE_LAUNCH_BILLING_ENABLED=false
VITE_LAUNCH_TESTER_MODE=false
VITE_LAUNCH_PREMIUM_UNLOCKED=false
VITE_LAUNCH_SOFT_MODE=true
VITE_LAUNCH_FOUNDER_OPS=false
VITE_LAUNCH_AI_COACH_ENABLED=false
VITE_LAUNCH_AI_COACH_TESTER_ONLY=true
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_FUNCTIONS_HOST=127.0.0.1
VITE_FIREBASE_FUNCTIONS_PORT=5001
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD=1
VITE_SUPPORT_EMAIL=
 
# Development tip: add http://localhost as authorized domain in Firebase console
# After editing .env, restart the dev server (`npm run dev`).

# Admin tooling (Node scripts only; not exposed to the client bundle)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Functions / AI Coach (server-side only; keep real values out of the client bundle)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_COACH_ENABLED=false
AI_COACH_TESTER_ONLY=true
AI_COACH_MAX_DAILY_REQUESTS=5
