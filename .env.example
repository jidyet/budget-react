# Copy this file to .env and fill values (do NOT commit real keys)
# Required from Firebase Console -> Project settings -> Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_MEASUREMENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_BILLING_API_URL=
VITE_STRIPE_CHECKOUT_URL=
VITE_STRIPE_CHECKOUT_URL_MONTHLY=
VITE_STRIPE_CHECKOUT_URL_YEARLY=
VITE_STRIPE_PORTAL_URL=
VITE_STRIPE_PRICE_PREMIUM_MONTHLY=
VITE_STRIPE_PRICE_PREMIUM_YEARLY=
 
# Development tip: add http://localhost as authorized domain in Firebase console
# After editing .env, restart the dev server (`npm run dev`).
