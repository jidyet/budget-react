{
  "name": "budget-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "emulators:v2": "node scripts/start-v2-local-emulators.mjs",
    "dev:v2-local": "vite --mode v2-local --port 5184",
    "build": "vite build",
    "build:beta": "vite build --mode beta",
    "perf:check": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore": "node scripts/run-firestore-tests.mjs",
    "test:firestore:v2": "node scripts/run-firestore-v2-tests.mjs",
    "test:firestore:beta": "node scripts/run-firestore-beta-tests.mjs",
    "deploy:beta": "node scripts/deploy-beta.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "firebase": "^12.10.0",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^15.24.0",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
