rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function isRequiredString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isHouseholdRole(value) {
      return value in ["owner", "admin", "member", "viewer"];
    }

    function isJoinMode(value) {
      return value in ["open", "approval"];
    }

    function isMemberStatus(value) {
      return value in ["active", "inactive"];
    }

    function isJoinRequestStatus(value) {
      return value in ["pending", "approved", "rejected"];
    }

    function validTimestamp(value) {
      return value is timestamp;
    }

    function validStringList(value) {
      return value is list;
    }

    function householdMemberDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isActiveHouseholdMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
        && householdMemberDoc(householdId).data.status == "active";
    }

    function isHouseholdAdmin(householdId) {
      return isActiveHouseholdMember(householdId)
        && householdMemberDoc(householdId).data.role in ["owner", "admin"];
    }

    function isAppAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function validAdminWorkspaceReset() {
      return validUserWorkspaceFields(request.resource.data)
        && request.resource.data.workspaceMode == "solo"
        && request.resource.data.activeHouseholdId == ""
        && request.resource.data.pendingHouseholdId == ""
        && request.resource.data.pendingHouseholdName == "";
    }

    function isHouseholdOwnerFromRoot(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid;
    }

    function rootDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function rootJoinMode(householdId) {
      return rootDoc(householdId).data.joinMode;
    }

    function validHouseholdRootCreate(householdId) {
      return request.resource.data.keys().hasAll([
          "name", "description", "joinMode", "joinCode", "ownerId",
          "memberIds", "memberCount", "active", "createdAt", "updatedAt",
          "updatedBy", "updatedByLabel", "dailyMessage"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "description", "joinMode", "joinCode", "ownerId", "ownerEmail",
          "memberIds", "memberCount", "active", "createdAt", "updatedAt",
          "updatedBy", "updatedByLabel", "dailyMessage", "schemaVersion"
        ])
        && isRequiredString(request.resource.data.name, 80)
        && isShortString(request.resource.data.description, 220)
        && isJoinMode(request.resource.data.joinMode)
        && isRequiredString(request.resource.data.joinCode, 12)
        && request.resource.data.ownerId == request.auth.uid
        && validStringList(request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.active == true
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && isShortString(request.resource.data.dailyMessage, 160);
    }

    function validHouseholdRootUpdate(householdId) {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.createdAt == resource.data.createdAt
        && isRequiredString(request.resource.data.name, 80)
        && isShortString(request.resource.data.description, 220)
        && isJoinMode(request.resource.data.joinMode)
        && validStringList(request.resource.data.memberIds)
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && request.resource.data.active is bool
        && validTimestamp(request.resource.data.updatedAt)
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && isShortString(request.resource.data.dailyMessage, 160);
    }

    function validOpenJoinRootUpdate(householdId) {
      return rootJoinMode(householdId) == "open"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberIds", "memberCount", "updatedAt", "updatedBy", "updatedByLabel"
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.dailyMessage == resource.data.dailyMessage
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && !resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function validLeaveRootUpdate(householdId) {
      return isActiveHouseholdMember(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberIds", "memberCount", "updatedAt", "updatedBy", "updatedByLabel"
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.memberCount == resource.data.memberCount - 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && resource.data.memberIds.hasAny([request.auth.uid])
        && !request.resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function validInvitedJoinRootUpdate(householdId) {
      return hasPendingHouseholdInvite(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberIds", "memberCount", "updatedAt", "updatedBy", "updatedByLabel"
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.dailyMessage == resource.data.dailyMessage
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && !resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function validDirectoryDoc(householdId) {
      return request.resource.data.keys().hasAll([
          "householdId", "name", "nameLower", "description", "joinCode",
          "joinMode", "ownerId", "memberCount", "active", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "householdId", "name", "nameLower", "description", "joinCode",
          "joinMode", "ownerId", "memberCount", "active", "updatedAt"
        ])
        && request.resource.data.householdId == householdId
        && isRequiredString(request.resource.data.name, 80)
        && isShortString(request.resource.data.nameLower, 80)
        && isShortString(request.resource.data.description, 220)
        && isRequiredString(request.resource.data.joinCode, 12)
        && isJoinMode(request.resource.data.joinMode)
        && isRequiredString(request.resource.data.ownerId, 120)
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 0
        && request.resource.data.active is bool
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validOpenJoinDirectoryUpdate(householdId) {
      return rootJoinMode(householdId) == "open"
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameLower == resource.data.nameLower
        && request.resource.data.description == resource.data.description
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.active == resource.data.active
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validInvitedJoinDirectoryUpdate(householdId) {
      return hasPendingHouseholdInvite(householdId)
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameLower == resource.data.nameLower
        && request.resource.data.description == resource.data.description
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.active == resource.data.active
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validMemberDoc(memberId) {
      return request.resource.data.keys().hasAll([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "role", "status", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "role", "status", "joinedAt", "updatedAt"
        ])
        && request.resource.data.uid == memberId
        && isShortString(request.resource.data.email, 160)
        && isRequiredString(request.resource.data.label, 120)
        && isRequiredString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.photoURL, 12000)
        && isShortString(request.resource.data.avatarColor, 32)
        && isHouseholdRole(request.resource.data.role)
        && isMemberStatus(request.resource.data.status)
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validSelfMemberProfileUpdate(memberId) {
      return request.auth.uid == memberId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "label", "displayName", "photoURL", "avatarColor", "updatedAt"
        ])
        && isRequiredString(request.resource.data.label, 120)
        && isRequiredString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.photoURL, 12000)
        && isShortString(request.resource.data.avatarColor, 32)
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validJoinRequest(requestId) {
      return request.resource.data.keys().hasAll([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "status", "createdAt", "updatedAt",
          "reviewedAt", "reviewedBy"
        ])
        && request.resource.data.uid == requestId
        && isShortString(request.resource.data.email, 160)
        && isRequiredString(request.resource.data.label, 120)
        && isRequiredString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.photoURL, 12000)
        && isShortString(request.resource.data.avatarColor, 32)
        && isJoinRequestStatus(request.resource.data.status);
    }

    function isFeedbackCategory(value) {
      return value in ["confusing", "bug", "helpful", "idea", "other"];
    }

    function isInviteStatus(value) {
      return value in ["pending", "requested", "accepted", "declined"];
    }

    function hasPendingHouseholdInvite(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/invites/$(householdId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/invites/$(householdId)).data.status == "pending";
    }

    function validHouseholdInviteDoc(householdId) {
      return request.resource.data.keys().hasAll([
          "householdId", "householdName", "householdDescription", "joinCode",
          "joinMode", "invitedByUid", "invitedByEmail", "invitedByName",
          "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "householdId", "householdName", "householdDescription", "joinCode",
          "joinMode", "invitedByUid", "invitedByEmail", "invitedByName",
          "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.householdId == householdId
        && isRequiredString(request.resource.data.householdName, 80)
        && isShortString(request.resource.data.householdDescription, 220)
        && isRequiredString(request.resource.data.joinCode, 12)
        && isJoinMode(request.resource.data.joinMode)
        && isRequiredString(request.resource.data.invitedByUid, 120)
        && isShortString(request.resource.data.invitedByEmail, 160)
        && isRequiredString(request.resource.data.invitedByName, 120)
        && isInviteStatus(request.resource.data.status)
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validUserWorkspaceFields(data) {
      return data.activeHouseholdId is string
        && isShortString(data.activeHouseholdId, 120)
        && data.householdSetupDone is bool
        && data.workspaceMode in ["solo", "household"]
        && data.pendingHouseholdId is string
        && isShortString(data.pendingHouseholdId, 120)
        && data.pendingHouseholdName is string
        && isShortString(data.pendingHouseholdName, 120)
        && validTimestamp(data.updatedAt);
    }

    function validManagedWorkspaceTransition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "activeHouseholdId", "householdSetupDone", "workspaceMode",
          "pendingHouseholdId", "pendingHouseholdName", "updatedAt"
        ])
        && validUserWorkspaceFields(request.resource.data);
    }

    function validManagedWorkspaceCreate() {
      return request.resource.data.keys().hasOnly([
          "activeHouseholdId", "householdSetupDone", "workspaceMode",
          "pendingHouseholdId", "pendingHouseholdName", "updatedAt"
        ])
        && validUserWorkspaceFields(request.resource.data);
    }

    function canCreateManagedUserWorkspaceForHousehold(uid) {
      return resource == null
        && validManagedWorkspaceCreate()
        && request.resource.data.activeHouseholdId.size() > 0
        && (
          isHouseholdAdmin(request.resource.data.activeHouseholdId)
          || isHouseholdOwnerFromRoot(request.resource.data.activeHouseholdId)
        )
        && request.resource.data.householdSetupDone == true
        && request.resource.data.workspaceMode == "household"
        && request.resource.data.pendingHouseholdId == ""
        && request.resource.data.pendingHouseholdName == "";
    }

    function canUpdateManagedUserWorkspaceForHousehold(uid) {
      return resource != null
        && resource.data != null
        && validManagedWorkspaceTransition()
        && (
          (
            resource.data.activeHouseholdId is string
            && resource.data.activeHouseholdId.size() > 0
            && (
              isHouseholdAdmin(resource.data.activeHouseholdId)
              || isHouseholdOwnerFromRoot(resource.data.activeHouseholdId)
            )
            && request.resource.data.activeHouseholdId == ""
            && request.resource.data.workspaceMode == "solo"
            && request.resource.data.pendingHouseholdId == ""
            && request.resource.data.pendingHouseholdName == ""
          )
          || (
            request.resource.data.activeHouseholdId.size() > 0
            && (
              isHouseholdAdmin(request.resource.data.activeHouseholdId)
              || isHouseholdOwnerFromRoot(request.resource.data.activeHouseholdId)
            )
            && request.resource.data.workspaceMode == "household"
            && request.resource.data.pendingHouseholdId == ""
            && request.resource.data.pendingHouseholdName == ""
          )
        );
    }

    match /householdDirectory/{householdId} {
      allow read: if signedIn();
      // CREATE: any signed-in user may write a directory entry with valid data.
      // The directory is a public search index (name, joinCode, memberCount only —
      // nothing sensitive). No cross-document reads needed here, which avoids
      // timing problems (e.g. createHousehold writes the entry before the member
      // doc exists) and silent rule failures on the isHouseholdOwnerFromRoot /
      // isActiveHouseholdMember get() calls.
      allow create: if signedIn()
        && validDirectoryDoc(householdId)
        && request.resource.data.ownerId == request.auth.uid;
      // UPDATE: only members/owner may modify an existing entry (prevents outsiders
      // from corrupting the name or joinCode of an established household).
      allow update: if validDirectoryDoc(householdId)
        && (
          isActiveHouseholdMember(householdId)
          || isHouseholdOwnerFromRoot(householdId)
          || validOpenJoinDirectoryUpdate(householdId)
          || validInvitedJoinDirectoryUpdate(householdId)
        );
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAppAdmin();
      allow write: if isOwner(uid) || isAppAdmin();

      match /meta/app {
        allow read: if isOwner(uid) || isAppAdmin();
        allow create: if isOwner(uid) || canCreateManagedUserWorkspaceForHousehold(uid) || (isAppAdmin() && validAdminWorkspaceReset());
        allow update: if isOwner(uid) || canUpdateManagedUserWorkspaceForHousehold(uid) || (isAppAdmin() && validAdminWorkspaceReset());
        allow delete: if isAppAdmin();
      }

      match /invites/{householdId} {
        allow read: if isOwner(uid);
        allow create: if validHouseholdInviteDoc(householdId)
          && request.resource.data.status == "pending"
          && (
            isHouseholdAdmin(householdId)
            || isHouseholdOwnerFromRoot(householdId)
          );
        allow update: if isOwner(uid)
          && validHouseholdInviteDoc(householdId)
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdName == resource.data.householdName
          && request.resource.data.householdDescription == resource.data.householdDescription
          && request.resource.data.joinCode == resource.data.joinCode
          && request.resource.data.joinMode == resource.data.joinMode
          && request.resource.data.invitedByUid == resource.data.invitedByUid
          && request.resource.data.invitedByEmail == resource.data.invitedByEmail
          && request.resource.data.invitedByName == resource.data.invitedByName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ["requested", "accepted", "declined"];
        allow delete: if isOwner(uid)
          || isHouseholdAdmin(householdId)
          || isHouseholdOwnerFromRoot(householdId)
          || isAppAdmin();
      }

      match /{document=**} {
        allow read, write: if isOwner(uid) || isAppAdmin();
      }
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "userId", "userEmail", "userLabel", "page", "category",
          "rating", "message", "whatConfused", "whatHelped", "whatShouldChange",
          "workspaceMode", "version", "build", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "userId", "userEmail", "userLabel", "page", "category",
          "rating", "message", "whatConfused", "whatHelped", "whatShouldChange",
          "workspaceMode", "version", "build", "status", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && isShortString(request.resource.data.userEmail, 160)
        && isRequiredString(request.resource.data.userLabel, 120)
        && isRequiredString(request.resource.data.page, 80)
        && isFeedbackCategory(request.resource.data.category)
        && (request.resource.data.rating == null || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && isRequiredString(request.resource.data.message, 1400)
        && isShortString(request.resource.data.whatConfused, 400)
        && isShortString(request.resource.data.whatHelped, 400)
        && isShortString(request.resource.data.whatShouldChange, 400)
        && request.resource.data.workspaceMode in ["solo", "household"]
        && isRequiredString(request.resource.data.version, 40)
        && isRequiredString(request.resource.data.build, 80)
        && request.resource.data.status == "new"
        && validTimestamp(request.resource.data.createdAt);
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // User registry — each authenticated user writes their own sanitized profile on login.
    // Admins can read all entries for the admin panel.
    match /registry/{uid} {
      allow read: if isOwner(uid) || isAppAdmin();
      allow write: if isOwner(uid) || isAppAdmin();
    }

    // App-level config. /config/admins contains uids: [...] for admin checks.
    // Write only via Firebase console or Admin SDK.
    match /config/{docId} {
      allow read: if isAppAdmin();
      allow write: if isAppAdmin();
    }

    match /households/{householdId} {
      // get: any signed-in user can fetch a single household root by ID.
      // Required for join-code/invite-link flows where the user knows the householdId.
      // list: restricted to members only — prevents enumeration of all households.
      allow get: if signedIn();
      allow list: if isActiveHouseholdMember(householdId) || isAppAdmin();
      allow create: if signedIn() && validHouseholdRootCreate(householdId);
      allow update: if isAppAdmin()
        || (validHouseholdRootUpdate(householdId)
        && (
          isHouseholdAdmin(householdId)
          || validOpenJoinRootUpdate(householdId)
          || validInvitedJoinRootUpdate(householdId)
          || validLeaveRootUpdate(householdId)
        ));

      match /members/{memberId} {
        allow read: if isActiveHouseholdMember(householdId)
          || (signedIn() && request.auth.uid == memberId)
          || isAppAdmin();
        allow create: if validMemberDoc(memberId)
          && (
            (isHouseholdOwnerFromRoot(householdId) && request.auth.uid == memberId && request.resource.data.role == "owner")
            || (isHouseholdAdmin(householdId) && request.resource.data.role in ["admin", "member", "viewer"])
            || (
              rootJoinMode(householdId) == "open"
              && request.auth.uid == memberId
              && request.resource.data.role == "member"
              && request.resource.data.status == "active"
            )
            || (
              hasPendingHouseholdInvite(householdId)
              && request.auth.uid == memberId
              && request.resource.data.role == "member"
              && request.resource.data.status == "active"
            )
          );
        allow update: if isAppAdmin()
          || (validMemberDoc(memberId)
          && (
            isHouseholdOwnerFromRoot(householdId)
            || (
              isHouseholdAdmin(householdId)
              && !isHouseholdOwnerFromRoot(householdId)
              && resource.data.role != "owner"
              && request.resource.data.role in ["admin", "member", "viewer"]
            )
            || (isActiveHouseholdMember(householdId) && validSelfMemberProfileUpdate(memberId))
          ));
        // Admins can remove any non-owner member; members can leave themselves (not if owner)
        allow delete: if isHouseholdAdmin(householdId)
          || isAppAdmin()
          || (isActiveHouseholdMember(householdId) && request.auth.uid == memberId && resource.data.role != "owner");
      }

      match /joinRequests/{requestId} {
        allow read: if isHouseholdAdmin(householdId) || (signedIn() && request.auth.uid == requestId);
        allow create: if signedIn()
          && request.auth.uid == requestId
          && validJoinRequest(requestId)
          && request.resource.data.status == "pending"
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);
        allow update: if isHouseholdAdmin(householdId)
          && validJoinRequest(requestId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.label == resource.data.label
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.photoURL == resource.data.photoURL
          && request.resource.data.avatarColor == resource.data.avatarColor
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ["approved", "rejected"]
          && validTimestamp(request.resource.data.reviewedAt)
          && request.resource.data.reviewedBy == request.auth.uid;
        // Allow the requester to delete their own request (withdraw pending, clear rejection to re-request)
        allow delete: if isHouseholdAdmin(householdId)
          || (signedIn() && request.auth.uid == requestId);
      }

      match /months/{monthKey} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);

        match /accounts/{accountId} {
          allow read: if isActiveHouseholdMember(householdId);
          allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
        }

        match /uploads/{uploadId} {
          allow read: if isActiveHouseholdMember(householdId);
          allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
        }
      }

      match /payoff_plans/{planId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
      }

      match /meta/{docId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
      }

      match /activity/{activityId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow create: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
        allow update, delete: if false;
      }

      match /dashboard/{docId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
      }
    }

    function v2MemberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function v2Membership(workspaceId) {
      return get(v2MemberPath(workspaceId, request.auth.uid));
    }

    function v2IsMember(workspaceId) {
      return signedIn()
        && exists(v2MemberPath(workspaceId, request.auth.uid))
        && v2Membership(workspaceId).data.status == "active";
    }

    function v2Role(workspaceId) {
      return v2Membership(workspaceId).data.role;
    }

    function v2ViewerPlus(workspaceId) {
      return v2IsMember(workspaceId) && v2Role(workspaceId) in ["owner", "admin", "contributor", "viewer"];
    }

    function v2ContributorPlus(workspaceId) {
      return v2IsMember(workspaceId) && v2Role(workspaceId) in ["owner", "admin", "contributor"];
    }

    function v2AdminPlus(workspaceId) {
      return v2IsMember(workspaceId) && v2Role(workspaceId) in ["owner", "admin"];
    }

    function v2Owner(workspaceId) {
      return v2IsMember(workspaceId) && v2Role(workspaceId) == "owner";
    }

    function v2MigrationOperator(workspaceId) {
      return v2AdminPlus(workspaceId)
        && "trackToZeroMigrationOperator" in request.auth.token
        && request.auth.token.trackToZeroMigrationOperator == true;
    }

    function v2ValidRole(value) {
      return value in ["owner", "admin", "contributor", "viewer"];
    }

    // BETA-3: the controlled-beta gate. Cohort 1 has zero pre-existing
    // real workspaces/members (only synthetic @ux9.test verification
    // accounts, which are not on this allowlist either), so gating
    // every bootstrap/join path is safe - there is nothing real to
    // grandfather in. Reads the SAME beta_allowlist doc the client's
    // own "am I approved" check reads (match /beta_allowlist/{...}
    // above), so a tester's UI state and what the rules actually
    // enforce can never disagree.
    function v2BetaApproved() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/beta_allowlist/$(request.auth.token.email))
        && get(/databases/$(database)/documents/beta_allowlist/$(request.auth.token.email)).data.status == "active";
    }

    function v2WorkspaceCreator(workspaceId) {
      return signedIn()
        && v2BetaApproved()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == workspaceId;
    }

    function v2WorkspaceCreatedByAfter(workspaceId, uid) {
      return existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId))
        && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == uid;
    }

    function v2OwnerMembershipAfter(workspaceId, uid) {
      return existsAfter(v2MemberPath(workspaceId, uid))
        && getAfter(v2MemberPath(workspaceId, uid)).data.workspaceId == workspaceId
        && getAfter(v2MemberPath(workspaceId, uid)).data.uid == uid
        && getAfter(v2MemberPath(workspaceId, uid)).data.role == "owner"
        && getAfter(v2MemberPath(workspaceId, uid)).data.status == "active";
    }

    function v2InitialOwnerMembership(workspaceId, uid) {
      return signedIn()
        && v2BetaApproved()
        && uid == request.auth.uid
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "owner"
        && request.resource.data.status == "active"
        && ((
          exists(/databases/$(database)/documents/workspaces/$(workspaceId))
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid
        ) || v2WorkspaceCreatedByAfter(workspaceId, request.auth.uid));
    }

    function v2BootstrapMigrationRun(workspaceId) {
      return signedIn()
        && "trackToZeroMigrationOperator" in request.auth.token
        && request.auth.token.trackToZeroMigrationOperator == true
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.migrationState == "in_progress"
        && v2WorkspaceCreatedByAfter(workspaceId, request.auth.uid)
        && v2OwnerMembershipAfter(workspaceId, request.auth.uid);
    }

    function v2RoleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    function v2TargetIsOwner(workspaceId, uid) {
      return exists(v2MemberPath(workspaceId, uid)) && get(v2MemberPath(workspaceId, uid)).data.role == "owner";
    }

    function v2InvitePath(workspaceId, inviteId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/member_invites/$(inviteId);
    }

    function v2InviteRoleValid(inviteData) {
      return inviteData.role in ["admin", "contributor", "viewer"];
    }

    function v2InviteCoreUnchanged() {
      return request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.id == resource.data.id
        && request.resource.data.tokenHash == resource.data.tokenHash
        && request.resource.data.emailNormalized == resource.data.emailNormalized
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.invitedByUserId == resource.data.invitedByUserId
        && request.resource.data.expiresAt == resource.data.expiresAt;
    }

    function v2InviteMatchesSignedInEmail(inviteData) {
      return signedIn()
        && "email" in request.auth.token
        && request.auth.token.email == inviteData.emailNormalized;
    }

    function v2AcceptedInviteAfter(workspaceId, inviteId, uid) {
      return existsAfter(v2InvitePath(workspaceId, inviteId))
        && getAfter(v2InvitePath(workspaceId, inviteId)).data.workspaceId == workspaceId
        && getAfter(v2InvitePath(workspaceId, inviteId)).data.id == inviteId
        && getAfter(v2InvitePath(workspaceId, inviteId)).data.status == "accepted"
        && getAfter(v2InvitePath(workspaceId, inviteId)).data.acceptedByUserId == uid
        && v2InviteMatchesSignedInEmail(getAfter(v2InvitePath(workspaceId, inviteId)).data)
        && getAfter(v2InvitePath(workspaceId, inviteId)).data.expiresAt > request.time;
    }

    function v2InviteAcceptanceMembership(workspaceId, uid) {
      return signedIn()
        && v2BetaApproved()
        && uid == request.auth.uid
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.uid == uid
        && request.resource.data.status == "active"
        && v2ValidRole(request.resource.data.role)
        && request.resource.data.role != "owner"
        && "acceptedInviteId" in request.resource.data
        && request.resource.data.acceptedInviteId is string
        && v2AcceptedInviteAfter(workspaceId, request.resource.data.acceptedInviteId, uid)
        && request.resource.data.role == getAfter(v2InvitePath(workspaceId, request.resource.data.acceptedInviteId)).data.role;
    }

    function v2IsInviteAcceptanceUpdate(workspaceId, inviteId) {
      return resource != null
        && signedIn()
        && resource.data.workspaceId == workspaceId
        && resource.data.id == inviteId
        && resource.data.status == "pending"
        && v2InviteCoreUnchanged()
        && request.resource.data.status == "accepted"
        && request.resource.data.acceptedByUserId == request.auth.uid
        && request.resource.data.canceledAt == resource.data.canceledAt
        && request.resource.data.canceledByUserId == resource.data.canceledByUserId
        && request.resource.data.expiresAt > request.time
        && v2InviteMatchesSignedInEmail(resource.data)
        && existsAfter(v2MemberPath(workspaceId, request.auth.uid))
        && getAfter(v2MemberPath(workspaceId, request.auth.uid)).data.workspaceId == workspaceId
        && getAfter(v2MemberPath(workspaceId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(v2MemberPath(workspaceId, request.auth.uid)).data.acceptedInviteId == inviteId;
    }

    function v2IsSelfPersonLink(workspaceId, personId) {
      return resource != null
        && signedIn()
        && v2IsMember(workspaceId)
        && resource.data.workspaceId == workspaceId
        && resource.data.id == personId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.id == personId
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.normalizedName == resource.data.normalizedName
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.status == resource.data.status
        && request.resource.data.mergedIntoPersonId == resource.data.mergedIntoPersonId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.aliases == resource.data.aliases
        && request.resource.data.workspaceMembershipId == request.auth.uid
        && (resource.data.workspaceMembershipId == null || resource.data.workspaceMembershipId == "")
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function v2PaymentCoreUnchanged() {
      return request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.debtId == resource.data.debtId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.paidAt == resource.data.paidAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function v2SnapshotCoreUnchanged() {
      return request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.debtId == resource.data.debtId
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.observedAt == resource.data.observedAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // UX-8.2: mirrors firestore.v2.rules' debtIdentityUnchanged() exactly -
    // see that file for the full rationale. This is the file that
    // `firebase deploy` actually ships, so the guard must live here too.
    function v2DebtIdentityUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.openingBalanceSnapshotId == resource.data.openingBalanceSnapshotId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function v2OpeningSnapshotPath(workspaceId, debtId, snapshotId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/debts/$(debtId)/balance_snapshots/$(snapshotId);
    }

    function v2OpeningSnapshotCreatedWithDebt(workspaceId, debtId) {
      return "openingBalanceSnapshotId" in request.resource.data
        && request.resource.data.openingBalanceSnapshotId is string
        && existsAfter(v2OpeningSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId))
        && getAfter(v2OpeningSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.workspaceId == workspaceId
        && getAfter(v2OpeningSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.debtId == debtId
        && getAfter(v2OpeningSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.balance == request.resource.data.currentBalance
        && getAfter(v2OpeningSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.createdBy == request.auth.uid
        && getAfter(v2OpeningSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.source in ["manual", "import"];
    }

    // ============================================================
    // BETA-3: controlled-beta tester allowlist. THIS FILE
    // (firestore.beta.rules) IS THE ONLY PLACE THIS EXISTS - never
    // copy this block into firestore.rules, which is what
    // `firebase deploy` ships for the production project
    // (budgetapp-c9306). Deploying this file requires an explicit
    // --config pointing at a beta-only firebase config; see
    // scripts/deploy-beta.mjs.
    //
    // Doc id is the tester's own lowercased/trimmed email (matching
    // the same normalization convention already used for invite
    // emailNormalized elsewhere in this file) - never a numeric id a
    // client could enumerate by guessing. A signed-in user may `get`
    // ONLY their own doc (to know whether they're approved yet, for
    // the app's own "you're on the invite-only waitlist" UI) - `list`
    // is denied outright, so a tester can never see who else is
    // approved. No client write path exists at all: allowlisting is
    // exclusively performed by tools/betaAccess.cjs via the Admin SDK,
    // which bypasses rules entirely - a tester can never self-approve
    // or approve anyone else through the app.
    //
    // Bug fix (found via live Gate-10 QA against the real deployed
    // beta site): the original condition also required
    // `resource.data.email == request.auth.token.email`, which
    // dereferences `resource` - undefined for a document that doesn't
    // exist yet. Firestore denies (rather than 404s) a `get` whose
    // rule can't evaluate `resource.data` on a missing document, so
    // every NOT-YET-APPROVED tester's own "am I approved?" read was
    // rejected outright as permission-denied instead of resolving to
    // "not found" - indistinguishable, client-side, from a real
    // permission failure. `identityId == request.auth.token.email`
    // alone already guarantees a user can only ever address their own
    // document id; the extra resource.data check added no additional
    // restriction, only this bug.
    match /beta_allowlist/{identityId} {
      allow get: if signedIn()
        && request.auth.token.email != null
        && identityId == request.auth.token.email;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Top-level mirror of each active /workspaces/{workspaceId}/members/{uid}
    // doc, keyed by `${workspaceId}_${uid}` - lets listMembershipsForUser
    // find "every workspace this user belongs to" via a plain top-level
    // query. A collectionGroup("members") query can't do this: Firestore's
    // rules engine cannot prove a field-based rule safe for a
    // collectionGroup query whose parent path is a wildcard (confirmed by
    // isolated testing - the identical rule+query works at the top level
    // and for a single, known-workspace nested query, but is
    // unconditionally denied once collectionGroup + wildcard parent are
    // combined, regardless of rule wording). Kept in sync at every write
    // site that creates a /members/{uid} doc (see saveMembership,
    // acceptMemberInvite) - if you add a way to update or remove a
    // membership, mirror that write here too or this index will drift.
    match /member_index/{indexId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if indexId == request.resource.data.workspaceId + "_" + request.resource.data.uid
        && (v2InitialOwnerMembership(request.resource.data.workspaceId, request.resource.data.uid)
          || v2InviteAcceptanceMembership(request.resource.data.workspaceId, request.resource.data.uid)
          || (v2MigrationOperator(request.resource.data.workspaceId)
            && request.resource.data.workspaceId is string
            && request.resource.data.uid is string
            && v2ValidRole(request.resource.data.role)));
      allow delete: if (v2Owner(resource.data.workspaceId) && !v2TargetIsOwner(resource.data.workspaceId, resource.data.uid))
        || v2MigrationOperator(resource.data.workspaceId);
    }

    match /workspaces/{workspaceId} {
      allow create: if v2WorkspaceCreator(workspaceId);
      allow read: if v2ViewerPlus(workspaceId);
      allow update: if v2AdminPlus(workspaceId);
      allow delete: if v2Owner(workspaceId) || v2MigrationOperator(workspaceId);

      match /members/{uid} {
        allow read: if v2ViewerPlus(workspaceId) || (signedIn() && uid == request.auth.uid);
        allow create: if v2InitialOwnerMembership(workspaceId, uid)
          || v2InviteAcceptanceMembership(workspaceId, uid)
          || (v2MigrationOperator(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.uid == uid
            && v2ValidRole(request.resource.data.role));
        allow update: if v2Owner(workspaceId)
          && uid != request.auth.uid
          && !v2TargetIsOwner(workspaceId, uid)
          && v2ValidRole(request.resource.data.role)
          && request.resource.data.role == resource.data.role;
        allow update: if v2AdminPlus(workspaceId)
          && uid != request.auth.uid
          && !v2TargetIsOwner(workspaceId, uid)
          && v2RoleUnchanged();
        allow delete: if (v2Owner(workspaceId) && !v2TargetIsOwner(workspaceId, uid))
          || v2MigrationOperator(workspaceId);
      }

      match /member_invites/{inviteId} {
        allow get: if true;
        allow list: if v2ViewerPlus(workspaceId);
        allow create: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == inviteId
          && request.resource.data.tokenHash == inviteId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.invitedByUserId == request.auth.uid
          && request.resource.data.status == "pending"
          && v2InviteRoleValid(request.resource.data)
          && request.resource.data.emailNormalized is string
          && request.resource.data.expiresAt > request.time;
        allow update: if (v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && v2InviteRoleValid(request.resource.data))
          || v2IsInviteAcceptanceUpdate(workspaceId, inviteId);
        allow delete: if false;
      }

      match /import_batches/{batchId} {
        allow read: if v2ViewerPlus(workspaceId);
        allow create: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if v2MigrationOperator(workspaceId);
      }

      // DATA-HH1: a Workspace-scoped financial identity for a person who may
      // have no TrackToZero account at all - never an Auth user, never a
      // WorkspaceMembership, gates identically to import_batches/debts (same
      // manageDebts-tier role). No delete: a merge sets status "merged" via
      // update, it never removes the document, so Debt.ownerId references
      // never dangle.
      match /people/{personId} {
        allow read: if v2ViewerPlus(workspaceId);
        allow create: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == personId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if (v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == personId)
          || v2IsSelfPersonLink(workspaceId, personId);
      }

      match /debts/{debtId} {
        allow read: if v2ViewerPlus(workspaceId);
        allow create: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == debtId
          && request.resource.data.createdBy == request.auth.uid
          && v2OpeningSnapshotCreatedWithDebt(workspaceId, debtId);
        allow update: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && v2DebtIdentityUnchanged();
        allow delete: if v2AdminPlus(workspaceId)
          && resource.data.workspaceId == workspaceId;

        match /payment_events/{eventId} {
          allow read: if v2ViewerPlus(workspaceId);
          allow create: if v2ContributorPlus(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.debtId == debtId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.amount > 0;
          allow update: if v2AdminPlus(workspaceId) && v2PaymentCoreUnchanged();
          allow delete: if v2MigrationOperator(workspaceId)
            && resource.data.workspaceId == workspaceId
            && resource.data.debtId == debtId;
        }

        match /balance_snapshots/{snapshotId} {
          allow read: if v2ViewerPlus(workspaceId);
          allow create: if v2ContributorPlus(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.debtId == debtId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.balance >= 0;
          allow update: if v2AdminPlus(workspaceId) && v2SnapshotCoreUnchanged();
          allow delete: if v2MigrationOperator(workspaceId)
            && resource.data.workspaceId == workspaceId
            && resource.data.debtId == debtId;
        }
      }

      match /plans/{planId} {
        allow read: if v2ViewerPlus(workspaceId);
        allow create, update: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if v2AdminPlus(workspaceId)
          && resource.data.workspaceId == workspaceId;

        match /versions/{versionId} {
          allow read: if v2ViewerPlus(workspaceId);
          allow create: if v2AdminPlus(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.planId == planId;
          allow update: if v2AdminPlus(workspaceId) && request.resource.data == resource.data;
          allow delete: if v2MigrationOperator(workspaceId)
            && resource.data.workspaceId == workspaceId
            && resource.data.planId == planId;

          match /expected_schedule/{checkpointId} {
            allow read: if v2ViewerPlus(workspaceId);
            allow create: if v2AdminPlus(workspaceId)
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.planId == planId
              && request.resource.data.planVersionId == versionId;
            allow update: if false;
            allow delete: if v2MigrationOperator(workspaceId)
              && resource.data.workspaceId == workspaceId
              && resource.data.planId == planId
              && resource.data.planVersionId == versionId;
          }
        }
      }

      // UX-4: a Saved Scenario is deliberately never authoritative - it never
      // enters the Workspace.activePlanId -> PayoffPlan.activeVersionId ->
      // PlanVersion pointer chain on its own. Only applyScenario (managePlans
      // tier, same as reforecast) can promote it, via the existing
      // applyReforecast primitive. Gates identically to people/import_batches
      // (no delete - archiving sets status "archived" via update so a
      // scenario id, once shared/referenced, never dangles).
      match /scenarios/{scenarioId} {
        allow read: if v2ViewerPlus(workspaceId);
        allow create: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == scenarioId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if v2AdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == scenarioId;
        allow delete: if v2MigrationOperator(workspaceId);
      }

      match /migration_runs/{runId} {
        allow read: if v2AdminPlus(workspaceId);
        allow create: if (v2MigrationOperator(workspaceId) || v2BootstrapMigrationRun(workspaceId))
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.actorId == request.auth.uid;
        allow update: if v2MigrationOperator(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.actorId == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
