# Loaded automatically by Vite when running with --mode v2-local
# (see the "dev:v2-local" npm script). No secrets here - these are just
# local emulator addresses, safe to commit.
#
# This selects TrackToZero V2's "local beta" runtime mode: a real fresh-
# signup flow (AuthScreen, real signup/login, Personal/Household choice,
# Owner bootstrap) run entirely against LOCAL Firebase Auth + Firestore
# emulators. It starts from zero users/workspaces every time the emulators
# are freshly started - no seeding required or expected. It never falls
# back to production Firebase; see repositoryRuntime.js's fail-closed
# assertTrackToZeroV2LocalBetaConfig.
#
# Start the matching emulators first with: npm run emulators:v2
VITE_TRACKTOZERO_V2_REPOSITORY_MODE=localBeta
VITE_TRACKTOZERO_V2_FIRESTORE_EMULATOR_HOST=127.0.0.1:8090
VITE_TRACKTOZERO_V2_AUTH_EMULATOR_HOST=127.0.0.1:9199
