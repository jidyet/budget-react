rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }
    function membership(workspaceId) {
      return get(memberPath(workspaceId, request.auth.uid));
    }
    function isMember(workspaceId) {
      return signedIn()
        && exists(memberPath(workspaceId, request.auth.uid))
        && membership(workspaceId).data.status == "active";
    }
    function role(workspaceId) {
      return membership(workspaceId).data.role;
    }
    function isViewerPlus(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ["owner", "admin", "contributor", "viewer"];
    }
    function isContributorPlus(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ["owner", "admin", "contributor"];
    }
    function isAdminPlus(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ["owner", "admin"];
    }
    function isOwner(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) == "owner";
    }
    function isMigrationOperator(workspaceId) {
      return isAdminPlus(workspaceId)
        && "trackToZeroMigrationOperator" in request.auth.token
        && request.auth.token.trackToZeroMigrationOperator == true;
    }
    function validRole(value) {
      return value in ["owner", "admin", "contributor", "viewer"];
    }
    function isWorkspaceCreator(workspaceId) {
      return signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == workspaceId;
    }
    function workspaceCreatedByAfter(workspaceId, uid) {
      return existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId))
        && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == uid;
    }
    function ownerMembershipAfter(workspaceId, uid) {
      return existsAfter(memberPath(workspaceId, uid))
        && getAfter(memberPath(workspaceId, uid)).data.workspaceId == workspaceId
        && getAfter(memberPath(workspaceId, uid)).data.uid == uid
        && getAfter(memberPath(workspaceId, uid)).data.role == "owner"
        && getAfter(memberPath(workspaceId, uid)).data.status == "active";
    }
    function isInitialOwnerMembership(workspaceId, uid) {
      return signedIn()
        && uid == request.auth.uid
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "owner"
        && request.resource.data.status == "active"
        && ((
          exists(/databases/$(database)/documents/workspaces/$(workspaceId))
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid
        ) || workspaceCreatedByAfter(workspaceId, request.auth.uid));
    }
    function isBootstrapMigrationRun(workspaceId) {
      return signedIn()
        && "trackToZeroMigrationOperator" in request.auth.token
        && request.auth.token.trackToZeroMigrationOperator == true
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.migrationState == "in_progress"
        && workspaceCreatedByAfter(workspaceId, request.auth.uid)
        && ownerMembershipAfter(workspaceId, request.auth.uid);
    }
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }
    function targetIsOwner(workspaceId, uid) {
      return exists(memberPath(workspaceId, uid)) && get(memberPath(workspaceId, uid)).data.role == "owner";
    }
    function invitePath(workspaceId, inviteId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/member_invites/$(inviteId);
    }
    function inviteRoleValid(inviteData) {
      return inviteData.role in ["admin", "contributor", "viewer"];
    }
    function inviteCoreUnchanged() {
      return request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.id == resource.data.id
        && request.resource.data.tokenHash == resource.data.tokenHash
        && request.resource.data.emailNormalized == resource.data.emailNormalized
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.invitedByUserId == resource.data.invitedByUserId
        && request.resource.data.expiresAt == resource.data.expiresAt;
    }
    function inviteMatchesSignedInEmail(inviteData) {
      return signedIn()
        && "email" in request.auth.token
        && request.auth.token.email == inviteData.emailNormalized;
    }
    function acceptedInviteAfter(workspaceId, inviteId, uid) {
      return existsAfter(invitePath(workspaceId, inviteId))
        && getAfter(invitePath(workspaceId, inviteId)).data.workspaceId == workspaceId
        && getAfter(invitePath(workspaceId, inviteId)).data.id == inviteId
        && getAfter(invitePath(workspaceId, inviteId)).data.status == "accepted"
        && getAfter(invitePath(workspaceId, inviteId)).data.acceptedByUserId == uid
        && inviteMatchesSignedInEmail(getAfter(invitePath(workspaceId, inviteId)).data)
        && getAfter(invitePath(workspaceId, inviteId)).data.expiresAt > request.time;
    }
    function isInviteAcceptanceMembership(workspaceId, uid) {
      return signedIn()
        && uid == request.auth.uid
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.uid == uid
        && request.resource.data.status == "active"
        && validRole(request.resource.data.role)
        && request.resource.data.role != "owner"
        && "acceptedInviteId" in request.resource.data
        && request.resource.data.acceptedInviteId is string
        && acceptedInviteAfter(workspaceId, request.resource.data.acceptedInviteId, uid)
        && request.resource.data.role == getAfter(invitePath(workspaceId, request.resource.data.acceptedInviteId)).data.role;
    }
    function isInviteAcceptanceUpdate(workspaceId, inviteId) {
      return resource != null
        && signedIn()
        && resource.data.workspaceId == workspaceId
        && resource.data.id == inviteId
        && resource.data.status == "pending"
        && inviteCoreUnchanged()
        && request.resource.data.status == "accepted"
        && request.resource.data.acceptedByUserId == request.auth.uid
        && request.resource.data.canceledAt == resource.data.canceledAt
        && request.resource.data.canceledByUserId == resource.data.canceledByUserId
        && request.resource.data.expiresAt > request.time
        && inviteMatchesSignedInEmail(resource.data)
        && existsAfter(memberPath(workspaceId, request.auth.uid))
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.workspaceId == workspaceId
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.acceptedInviteId == inviteId;
    }
    function isSelfPersonLink(workspaceId, personId) {
      return resource != null
        && signedIn()
        && isMember(workspaceId)
        && resource.data.workspaceId == workspaceId
        && resource.data.id == personId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.id == personId
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.normalizedName == resource.data.normalizedName
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.status == resource.data.status
        && request.resource.data.mergedIntoPersonId == resource.data.mergedIntoPersonId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.aliases == resource.data.aliases
        && request.resource.data.workspaceMembershipId == request.auth.uid
        && (resource.data.workspaceMembershipId == null || resource.data.workspaceMembershipId == "")
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function immutablePaymentCoreUnchanged() {
      return request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.debtId == resource.data.debtId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.paidAt == resource.data.paidAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    function immutableSnapshotCoreUnchanged() {
      return request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.debtId == resource.data.debtId
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.observedAt == resource.data.observedAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    // UX-8.2: a debt-metadata edit (name/APR/owner/etc.) must never be able
    // to touch this debt's identity/system fields - those only ever change
    // at creation, never on an update, by any known flow.
    //
    // currentBalance/startingBalance/balanceStatus are deliberately NOT
    // locked here even though the new metadata-only updateDebt path never
    // sends them (that's enforced application-side by its field allow-list,
    // not here): updateDebtFromImportCandidate legitimately rewrites
    // currentBalance/balanceStatus on this same document, atomically, as
    // part of committing an import resolution against an existing debt
    // (tracktozeroRepositories.js / firebaseTrackToZeroRepository.js) - a
    // real, tested flow this guard must not break. Verifying that specific
    // write is paired with its balance_snapshots doc would require adding a
    // new referencing field to that flow's write shape, which risks
    // altering BalanceSnapshot/reconciliation semantics - out of scope for
    // this phase.
    function debtIdentityUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.openingBalanceSnapshotId == resource.data.openingBalanceSnapshotId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function openingSnapshotPath(workspaceId, debtId, snapshotId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/debts/$(debtId)/balance_snapshots/$(snapshotId);
    }
    function openingSnapshotCreatedWithDebt(workspaceId, debtId) {
      return "openingBalanceSnapshotId" in request.resource.data
        && request.resource.data.openingBalanceSnapshotId is string
        && existsAfter(openingSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId))
        && getAfter(openingSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.workspaceId == workspaceId
        && getAfter(openingSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.debtId == debtId
        && getAfter(openingSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.balance == request.resource.data.currentBalance
        && getAfter(openingSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.createdBy == request.auth.uid
        && getAfter(openingSnapshotPath(workspaceId, debtId, request.resource.data.openingBalanceSnapshotId)).data.source in ["manual", "import"];
    }
    function versionImmutable() {
      return request.resource.data == resource.data;
    }

    // Top-level mirror of each active /workspaces/{workspaceId}/members/{uid}
    // doc, keyed by `${workspaceId}_${uid}` - lets listMembershipsForUser
    // find "every workspace this user belongs to" via a plain top-level
    // query. A collectionGroup("members") query can't do this: Firestore's
    // rules engine cannot prove a field-based rule safe for a
    // collectionGroup query whose parent path is a wildcard (confirmed by
    // isolated testing - the identical rule+query works at the top level
    // and for a single, known-workspace nested query, but is
    // unconditionally denied once collectionGroup + wildcard parent are
    // combined, regardless of rule wording). Kept in sync at every write
    // site that creates a /members/{uid} doc (see saveMembership,
    // acceptMemberInvite) - if you add a way to update or remove a
    // membership, mirror that write here too or this index will drift.
    match /member_index/{indexId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if indexId == request.resource.data.workspaceId + "_" + request.resource.data.uid
        && (isInitialOwnerMembership(request.resource.data.workspaceId, request.resource.data.uid)
          || isInviteAcceptanceMembership(request.resource.data.workspaceId, request.resource.data.uid)
          || (isMigrationOperator(request.resource.data.workspaceId)
            && request.resource.data.workspaceId is string
            && request.resource.data.uid is string
            && validRole(request.resource.data.role)));
      allow delete: if (isOwner(resource.data.workspaceId) && !targetIsOwner(resource.data.workspaceId, resource.data.uid))
        || isMigrationOperator(resource.data.workspaceId);
    }

    match /workspaces/{workspaceId} {
      allow create: if isWorkspaceCreator(workspaceId);
      allow read: if isViewerPlus(workspaceId);
      allow update: if isAdminPlus(workspaceId);
      allow delete: if isOwner(workspaceId) || isMigrationOperator(workspaceId);

      match /members/{uid} {
        allow read: if isViewerPlus(workspaceId) || (signedIn() && uid == request.auth.uid);
        allow create: if isInitialOwnerMembership(workspaceId, uid)
          || isInviteAcceptanceMembership(workspaceId, uid)
          || (isMigrationOperator(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.uid == uid
            && validRole(request.resource.data.role));
        allow update: if isOwner(workspaceId)
          && uid != request.auth.uid
          && !targetIsOwner(workspaceId, uid)
          && validRole(request.resource.data.role)
          && request.resource.data.role == resource.data.role;
        allow update: if isAdminPlus(workspaceId)
          && uid != request.auth.uid
          && !targetIsOwner(workspaceId, uid)
          && roleUnchanged();
        allow delete: if (isOwner(workspaceId) && !targetIsOwner(workspaceId, uid))
          || isMigrationOperator(workspaceId);
      }

      match /member_invites/{inviteId} {
        allow get: if true;
        allow list: if isViewerPlus(workspaceId);
        allow create: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == inviteId
          && request.resource.data.tokenHash == inviteId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.invitedByUserId == request.auth.uid
          && request.resource.data.status == "pending"
          && inviteRoleValid(request.resource.data)
          && request.resource.data.emailNormalized is string
          && request.resource.data.expiresAt > request.time;
        allow update: if (isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && inviteRoleValid(request.resource.data))
          || isInviteAcceptanceUpdate(workspaceId, inviteId);
        allow delete: if false;
      }

      match /import_batches/{batchId} {
        allow read: if isViewerPlus(workspaceId);
        allow create: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if isMigrationOperator(workspaceId);
      }

      // DATA-HH1: a Workspace-scoped financial identity for a person who may
      // have no TrackToZero account at all - never an Auth user, never a
      // WorkspaceMembership, gates identically to import_batches/debts
      // (same manageDebts-tier role - createImportedPerson/confirmAlias/
      // mergeWorkspacePersons all require it in the application service).
      // No delete: a merge sets status "merged" via update, it never
      // removes the document, so Debt.ownerId references never dangle.
      match /people/{personId} {
        allow read: if isViewerPlus(workspaceId);
        allow create: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == personId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if (isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == personId)
          || isSelfPersonLink(workspaceId, personId);
      }

      match /debts/{debtId} {
        allow read: if isViewerPlus(workspaceId);
        allow create: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == debtId
          && request.resource.data.createdBy == request.auth.uid
          && openingSnapshotCreatedWithDebt(workspaceId, debtId);
        allow update: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && debtIdentityUnchanged();
        allow delete: if isAdminPlus(workspaceId)
          && resource.data.workspaceId == workspaceId;

        match /payment_events/{eventId} {
          allow read: if isViewerPlus(workspaceId);
          allow create: if isContributorPlus(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.debtId == debtId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.amount > 0;
          allow update: if isAdminPlus(workspaceId) && immutablePaymentCoreUnchanged();
          allow delete: if isMigrationOperator(workspaceId)
            && resource.data.workspaceId == workspaceId
            && resource.data.debtId == debtId;
        }

        match /balance_snapshots/{snapshotId} {
          allow read: if isViewerPlus(workspaceId);
          allow create: if isContributorPlus(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.debtId == debtId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.balance >= 0;
          allow update: if isAdminPlus(workspaceId) && immutableSnapshotCoreUnchanged();
          allow delete: if isMigrationOperator(workspaceId)
            && resource.data.workspaceId == workspaceId
            && resource.data.debtId == debtId;
        }
      }

      match /plans/{planId} {
        allow read: if isViewerPlus(workspaceId);
        allow create, update: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if isAdminPlus(workspaceId)
          && resource.data.workspaceId == workspaceId;

        match /versions/{versionId} {
          allow read: if isViewerPlus(workspaceId);
          allow create: if isAdminPlus(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.planId == planId;
          allow update: if isAdminPlus(workspaceId) && versionImmutable();
          allow delete: if isMigrationOperator(workspaceId)
            && resource.data.workspaceId == workspaceId
            && resource.data.planId == planId;

          match /expected_schedule/{checkpointId} {
            allow read: if isViewerPlus(workspaceId);
            allow create: if isAdminPlus(workspaceId)
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.planId == planId
              && request.resource.data.planVersionId == versionId;
            allow update: if false;
            allow delete: if isMigrationOperator(workspaceId)
              && resource.data.workspaceId == workspaceId
              && resource.data.planId == planId
              && resource.data.planVersionId == versionId;
          }
        }
      }

      // UX-4: a Saved Scenario is deliberately never authoritative - it never
      // enters the Workspace.activePlanId -> PayoffPlan.activeVersionId ->
      // PlanVersion pointer chain on its own. Only applyScenario (managePlans
      // tier, same as reforecast) can promote it, via the existing
      // applyReforecast primitive. Gates identically to people/import_batches
      // (no delete - archiving sets status "archived" via update so a
      // scenario id, once shared/referenced, never dangles).
      match /scenarios/{scenarioId} {
        allow read: if isViewerPlus(workspaceId);
        allow create: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == scenarioId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdminPlus(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == scenarioId;
        allow delete: if isMigrationOperator(workspaceId);
      }

      match /migration_runs/{runId} {
        allow read: if isAdminPlus(workspaceId);
        allow create: if (isMigrationOperator(workspaceId) || isBootstrapMigrationRun(workspaceId))
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.actorId == request.auth.uid;
        allow update: if isMigrationOperator(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.actorId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
