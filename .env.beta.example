# TrackToZero V2 controlled-beta build template (BETA-1 draft).
#
# This is a PREVIEW of the environment file a future beta build will need -
# copy to .env.beta (gitignored, same as .env) and fill in once a beta
# Firebase project has been approved and created. Do NOT fill in real values
# and commit them; do NOT point this at production budgetapp-c9306 values.
#
# IMPORTANT - this template alone is not yet sufficient to actually run a
# beta build against a NEW dedicated Firebase project. Today,
# assertTrackToZeroV2ProductionConfig (src/services/tracktozero/
# repositoryRuntime.js) hard-requires the configured Firebase project id to
# equal the constant TRACKTOZERO_V2_PRODUCTION_PROJECT_ID ("budgetapp-c9306")
# before it will run in firebaseProduction mode - this is a deliberate
# fail-closed safety check, not a bug, but it means a genuinely separate
# beta project cannot be used yet without a small, carefully-tested code
# change to make that expected project id configurable (see
# TRACKTOZERO_BETA1_ENVIRONMENT_DISCOVERY_RESULTS.md Section 24). That
# change is intentionally NOT made in BETA-1 - it belongs to whichever
# future phase actually creates and wires up the approved beta project.
#
# Use with: vite build --mode beta / vite --mode beta (a "build:beta"/
# "dev:beta" npm script does not exist yet either - add one alongside the
# real beta project setup, mirroring dev:v2-local's pattern).

# --- Firebase project this build talks to (PENDING OWNER APPROVAL) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- TrackToZero V2 runtime mode ---
# firebaseProduction is what a real (non-emulator) beta build uses - the
# same mode true production uses. There is currently no separate "beta"
# repository mode; the beta/production distinction lives entirely in WHICH
# Firebase project the above config points at, plus (once implemented) the
# environment-label flag below.
VITE_TRACKTOZERO_V2_REPOSITORY_MODE=

# --- Feature flags relevant to a controlled beta ---
VITE_TRACKTOZERO_V2_ENABLED=true
VITE_TRACKTOZERO_MIGRATION_ENABLED=false

# --- Environment label (NOT YET IMPLEMENTED - see Section 22) ---
# Proposed: a small, explicit label so the app can show a restrained "Beta"
# badge and, if ever needed, distinguish beta from true production without
# guessing from the project id. Design only in BETA-1; not wired into any
# component yet.
# VITE_TRACKTOZERO_V2_ENVIRONMENT_LABEL=beta
