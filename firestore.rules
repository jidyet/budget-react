rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function isRequiredString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isHouseholdRole(value) {
      return value in ["owner", "admin", "member", "viewer"];
    }

    function isJoinMode(value) {
      return value in ["open", "approval"];
    }

    function isMemberStatus(value) {
      return value in ["active", "inactive"];
    }

    function isJoinRequestStatus(value) {
      return value in ["pending", "approved", "rejected"];
    }

    function validTimestamp(value) {
      return value is timestamp;
    }

    function validStringList(value) {
      return value is list;
    }

    function householdMemberDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isActiveHouseholdMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
        && householdMemberDoc(householdId).data.status == "active";
    }

    function isHouseholdAdmin(householdId) {
      return isActiveHouseholdMember(householdId)
        && householdMemberDoc(householdId).data.role in ["owner", "admin"];
    }

    function isAppAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function validAdminWorkspaceReset() {
      return validUserWorkspaceFields(request.resource.data)
        && request.resource.data.workspaceMode == "solo"
        && request.resource.data.activeHouseholdId == ""
        && request.resource.data.pendingHouseholdId == ""
        && request.resource.data.pendingHouseholdName == "";
    }

    function isHouseholdOwnerFromRoot(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid;
    }

    function rootDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function rootJoinMode(householdId) {
      return rootDoc(householdId).data.joinMode;
    }

    function validHouseholdRootCreate(householdId) {
      return request.resource.data.keys().hasAll([
          "name", "description", "joinMode", "joinCode", "ownerId",
          "memberIds", "memberCount", "active", "createdAt", "updatedAt",
          "updatedBy", "updatedByLabel", "dailyMessage"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "description", "joinMode", "joinCode", "ownerId", "ownerEmail",
          "memberIds", "memberCount", "active", "createdAt", "updatedAt",
          "updatedBy", "updatedByLabel", "dailyMessage", "schemaVersion"
        ])
        && isRequiredString(request.resource.data.name, 80)
        && isShortString(request.resource.data.description, 220)
        && isJoinMode(request.resource.data.joinMode)
        && isRequiredString(request.resource.data.joinCode, 12)
        && request.resource.data.ownerId == request.auth.uid
        && validStringList(request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.active == true
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && isShortString(request.resource.data.dailyMessage, 160);
    }

    function validHouseholdRootUpdate(householdId) {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.createdAt == resource.data.createdAt
        && isRequiredString(request.resource.data.name, 80)
        && isShortString(request.resource.data.description, 220)
        && isJoinMode(request.resource.data.joinMode)
        && validStringList(request.resource.data.memberIds)
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && request.resource.data.active is bool
        && validTimestamp(request.resource.data.updatedAt)
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && isShortString(request.resource.data.dailyMessage, 160);
    }

    function validOpenJoinRootUpdate(householdId) {
      return rootJoinMode(householdId) == "open"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberIds", "memberCount", "updatedAt", "updatedBy", "updatedByLabel"
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.dailyMessage == resource.data.dailyMessage
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && !resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function validLeaveRootUpdate(householdId) {
      return isActiveHouseholdMember(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberIds", "memberCount", "updatedAt", "updatedBy", "updatedByLabel"
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.memberCount == resource.data.memberCount - 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && resource.data.memberIds.hasAny([request.auth.uid])
        && !request.resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function validInvitedJoinRootUpdate(householdId) {
      return hasPendingHouseholdInvite(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberIds", "memberCount", "updatedAt", "updatedBy", "updatedByLabel"
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.dailyMessage == resource.data.dailyMessage
        && request.resource.data.updatedBy == request.auth.uid
        && isRequiredString(request.resource.data.updatedByLabel, 120)
        && validTimestamp(request.resource.data.updatedAt)
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && !resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function validDirectoryDoc(householdId) {
      return request.resource.data.keys().hasAll([
          "householdId", "name", "nameLower", "description", "joinCode",
          "joinMode", "ownerId", "memberCount", "active", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "householdId", "name", "nameLower", "description", "joinCode",
          "joinMode", "ownerId", "memberCount", "active", "updatedAt"
        ])
        && request.resource.data.householdId == householdId
        && isRequiredString(request.resource.data.name, 80)
        && isShortString(request.resource.data.nameLower, 80)
        && isShortString(request.resource.data.description, 220)
        && isRequiredString(request.resource.data.joinCode, 12)
        && isJoinMode(request.resource.data.joinMode)
        && isRequiredString(request.resource.data.ownerId, 120)
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 0
        && request.resource.data.active is bool
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validOpenJoinDirectoryUpdate(householdId) {
      return rootJoinMode(householdId) == "open"
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameLower == resource.data.nameLower
        && request.resource.data.description == resource.data.description
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.active == resource.data.active
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validInvitedJoinDirectoryUpdate(householdId) {
      return hasPendingHouseholdInvite(householdId)
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameLower == resource.data.nameLower
        && request.resource.data.description == resource.data.description
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.joinMode == resource.data.joinMode
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.active == resource.data.active
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validMemberDoc(memberId) {
      return request.resource.data.keys().hasAll([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "role", "status", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "role", "status", "joinedAt", "updatedAt"
        ])
        && request.resource.data.uid == memberId
        && isShortString(request.resource.data.email, 160)
        && isRequiredString(request.resource.data.label, 120)
        && isRequiredString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.photoURL, 12000)
        && isShortString(request.resource.data.avatarColor, 32)
        && isHouseholdRole(request.resource.data.role)
        && isMemberStatus(request.resource.data.status)
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validSelfMemberProfileUpdate(memberId) {
      return request.auth.uid == memberId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "label", "displayName", "photoURL", "avatarColor", "updatedAt"
        ])
        && isRequiredString(request.resource.data.label, 120)
        && isRequiredString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.photoURL, 12000)
        && isShortString(request.resource.data.avatarColor, 32)
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validJoinRequest(requestId) {
      return request.resource.data.keys().hasAll([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "email", "label", "displayName", "photoURL",
          "avatarColor", "status", "createdAt", "updatedAt",
          "reviewedAt", "reviewedBy"
        ])
        && request.resource.data.uid == requestId
        && isShortString(request.resource.data.email, 160)
        && isRequiredString(request.resource.data.label, 120)
        && isRequiredString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.photoURL, 12000)
        && isShortString(request.resource.data.avatarColor, 32)
        && isJoinRequestStatus(request.resource.data.status);
    }

    function isFeedbackCategory(value) {
      return value in ["confusing", "bug", "helpful", "idea", "other"];
    }

    function isInviteStatus(value) {
      return value in ["pending", "requested", "accepted", "declined"];
    }

    function hasPendingHouseholdInvite(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/invites/$(householdId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/invites/$(householdId)).data.status == "pending";
    }

    function validHouseholdInviteDoc(householdId) {
      return request.resource.data.keys().hasAll([
          "householdId", "householdName", "householdDescription", "joinCode",
          "joinMode", "invitedByUid", "invitedByEmail", "invitedByName",
          "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "householdId", "householdName", "householdDescription", "joinCode",
          "joinMode", "invitedByUid", "invitedByEmail", "invitedByName",
          "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.householdId == householdId
        && isRequiredString(request.resource.data.householdName, 80)
        && isShortString(request.resource.data.householdDescription, 220)
        && isRequiredString(request.resource.data.joinCode, 12)
        && isJoinMode(request.resource.data.joinMode)
        && isRequiredString(request.resource.data.invitedByUid, 120)
        && isShortString(request.resource.data.invitedByEmail, 160)
        && isRequiredString(request.resource.data.invitedByName, 120)
        && isInviteStatus(request.resource.data.status)
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt);
    }

    function validUserWorkspaceFields(data) {
      return data.activeHouseholdId is string
        && isShortString(data.activeHouseholdId, 120)
        && data.householdSetupDone is bool
        && data.workspaceMode in ["solo", "household"]
        && data.pendingHouseholdId is string
        && isShortString(data.pendingHouseholdId, 120)
        && data.pendingHouseholdName is string
        && isShortString(data.pendingHouseholdName, 120)
        && validTimestamp(data.updatedAt);
    }

    function validManagedWorkspaceTransition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "activeHouseholdId", "householdSetupDone", "workspaceMode",
          "pendingHouseholdId", "pendingHouseholdName", "updatedAt"
        ])
        && validUserWorkspaceFields(request.resource.data);
    }

    function validManagedWorkspaceCreate() {
      return request.resource.data.keys().hasOnly([
          "activeHouseholdId", "householdSetupDone", "workspaceMode",
          "pendingHouseholdId", "pendingHouseholdName", "updatedAt"
        ])
        && validUserWorkspaceFields(request.resource.data);
    }

    function canCreateManagedUserWorkspaceForHousehold(uid) {
      return resource == null
        && validManagedWorkspaceCreate()
        && request.resource.data.activeHouseholdId.size() > 0
        && (
          isHouseholdAdmin(request.resource.data.activeHouseholdId)
          || isHouseholdOwnerFromRoot(request.resource.data.activeHouseholdId)
        )
        && request.resource.data.householdSetupDone == true
        && request.resource.data.workspaceMode == "household"
        && request.resource.data.pendingHouseholdId == ""
        && request.resource.data.pendingHouseholdName == "";
    }

    function canUpdateManagedUserWorkspaceForHousehold(uid) {
      return resource != null
        && resource.data != null
        && validManagedWorkspaceTransition()
        && (
          (
            resource.data.activeHouseholdId is string
            && resource.data.activeHouseholdId.size() > 0
            && (
              isHouseholdAdmin(resource.data.activeHouseholdId)
              || isHouseholdOwnerFromRoot(resource.data.activeHouseholdId)
            )
            && request.resource.data.activeHouseholdId == ""
            && request.resource.data.workspaceMode == "solo"
            && request.resource.data.pendingHouseholdId == ""
            && request.resource.data.pendingHouseholdName == ""
          )
          || (
            request.resource.data.activeHouseholdId.size() > 0
            && (
              isHouseholdAdmin(request.resource.data.activeHouseholdId)
              || isHouseholdOwnerFromRoot(request.resource.data.activeHouseholdId)
            )
            && request.resource.data.workspaceMode == "household"
            && request.resource.data.pendingHouseholdId == ""
            && request.resource.data.pendingHouseholdName == ""
          )
        );
    }

    match /householdDirectory/{householdId} {
      allow read: if signedIn();
      // CREATE: any signed-in user may write a directory entry with valid data.
      // The directory is a public search index (name, joinCode, memberCount only —
      // nothing sensitive). No cross-document reads needed here, which avoids
      // timing problems (e.g. createHousehold writes the entry before the member
      // doc exists) and silent rule failures on the isHouseholdOwnerFromRoot /
      // isActiveHouseholdMember get() calls.
      allow create: if signedIn()
        && validDirectoryDoc(householdId)
        && request.resource.data.ownerId == request.auth.uid;
      // UPDATE: only members/owner may modify an existing entry (prevents outsiders
      // from corrupting the name or joinCode of an established household).
      allow update: if validDirectoryDoc(householdId)
        && (
          isActiveHouseholdMember(householdId)
          || isHouseholdOwnerFromRoot(householdId)
          || validOpenJoinDirectoryUpdate(householdId)
          || validInvitedJoinDirectoryUpdate(householdId)
        );
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAppAdmin();
      // Entitlement is server-authoritative: `subscription` may only be created
      // or modified by isAppAdmin() (i.e. the Admin SDK from a trusted Cloud
      // Function, which bypasses these rules anyway; isAppAdmin() additionally
      // covers direct console/admin-tool writes). A client cannot self-grant
      // premium by writing to its own subscription field. See P0-1.
      allow create: if (isOwner(uid) || isAppAdmin())
        && (isAppAdmin() || !("subscription" in request.resource.data));
      allow update: if (isOwner(uid) || isAppAdmin())
        && (
          isAppAdmin()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["subscription"])
        );
      allow delete: if isOwner(uid) || isAppAdmin();

      match /meta/app {
        allow read: if isOwner(uid) || isAppAdmin();
        allow create: if isOwner(uid) || canCreateManagedUserWorkspaceForHousehold(uid) || (isAppAdmin() && validAdminWorkspaceReset());
        allow update: if isOwner(uid) || canUpdateManagedUserWorkspaceForHousehold(uid) || (isAppAdmin() && validAdminWorkspaceReset());
        allow delete: if isAppAdmin();
      }

      match /invites/{householdId} {
        allow read: if isOwner(uid);
        allow create: if validHouseholdInviteDoc(householdId)
          && request.resource.data.status == "pending"
          && (
            isHouseholdAdmin(householdId)
            || isHouseholdOwnerFromRoot(householdId)
          );
        allow update: if isOwner(uid)
          && validHouseholdInviteDoc(householdId)
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdName == resource.data.householdName
          && request.resource.data.householdDescription == resource.data.householdDescription
          && request.resource.data.joinCode == resource.data.joinCode
          && request.resource.data.joinMode == resource.data.joinMode
          && request.resource.data.invitedByUid == resource.data.invitedByUid
          && request.resource.data.invitedByEmail == resource.data.invitedByEmail
          && request.resource.data.invitedByName == resource.data.invitedByName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ["requested", "accepted", "declined"];
        allow delete: if isOwner(uid)
          || isHouseholdAdmin(householdId)
          || isHouseholdOwnerFromRoot(householdId)
          || isAppAdmin();
      }

      match /{document=**} {
        allow read, write: if isOwner(uid) || isAppAdmin();
      }
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "userId", "userEmail", "userLabel", "page", "category",
          "rating", "message", "whatConfused", "whatHelped", "whatShouldChange",
          "workspaceMode", "version", "build", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "userId", "userEmail", "userLabel", "page", "category",
          "rating", "message", "whatConfused", "whatHelped", "whatShouldChange",
          "workspaceMode", "version", "build", "status", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && isShortString(request.resource.data.userEmail, 160)
        && isRequiredString(request.resource.data.userLabel, 120)
        && isRequiredString(request.resource.data.page, 80)
        && isFeedbackCategory(request.resource.data.category)
        && (request.resource.data.rating == null || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && isRequiredString(request.resource.data.message, 1400)
        && isShortString(request.resource.data.whatConfused, 400)
        && isShortString(request.resource.data.whatHelped, 400)
        && isShortString(request.resource.data.whatShouldChange, 400)
        && request.resource.data.workspaceMode in ["solo", "household"]
        && isRequiredString(request.resource.data.version, 40)
        && isRequiredString(request.resource.data.build, 80)
        && request.resource.data.status == "new"
        && validTimestamp(request.resource.data.createdAt);
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // User registry — each authenticated user writes their own sanitized profile on login.
    // Admins can read all entries for the admin panel.
    match /registry/{uid} {
      allow read: if isOwner(uid) || isAppAdmin();
      allow write: if isOwner(uid) || isAppAdmin();
    }

    // App-level config. /config/admins contains uids: [...] for admin checks.
    // Write only via Firebase console or Admin SDK.
    match /config/{docId} {
      allow read: if isAppAdmin();
      allow write: if isAppAdmin();
    }

    match /households/{householdId} {
      // get: any signed-in user can fetch a single household root by ID.
      // Required for join-code/invite-link flows where the user knows the householdId.
      // list: restricted to members only — prevents enumeration of all households.
      allow get: if signedIn();
      allow list: if isActiveHouseholdMember(householdId) || isAppAdmin();
      allow create: if signedIn() && validHouseholdRootCreate(householdId);
      allow update: if isAppAdmin()
        || (validHouseholdRootUpdate(householdId)
        && (
          isHouseholdAdmin(householdId)
          || validOpenJoinRootUpdate(householdId)
          || validInvitedJoinRootUpdate(householdId)
          || validLeaveRootUpdate(householdId)
        ));

      match /members/{memberId} {
        allow read: if isActiveHouseholdMember(householdId)
          || (signedIn() && request.auth.uid == memberId)
          || isAppAdmin();
        allow create: if validMemberDoc(memberId)
          && (
            (isHouseholdOwnerFromRoot(householdId) && request.auth.uid == memberId && request.resource.data.role == "owner")
            || (isHouseholdAdmin(householdId) && request.resource.data.role in ["admin", "member", "viewer"])
            || (
              rootJoinMode(householdId) == "open"
              && request.auth.uid == memberId
              && request.resource.data.role == "member"
              && request.resource.data.status == "active"
            )
            || (
              hasPendingHouseholdInvite(householdId)
              && request.auth.uid == memberId
              && request.resource.data.role == "member"
              && request.resource.data.status == "active"
            )
          );
        allow update: if isAppAdmin()
          || (validMemberDoc(memberId)
          && (
            isHouseholdOwnerFromRoot(householdId)
            || (
              isHouseholdAdmin(householdId)
              && !isHouseholdOwnerFromRoot(householdId)
              && resource.data.role != "owner"
              && request.resource.data.role in ["admin", "member", "viewer"]
            )
            || (isActiveHouseholdMember(householdId) && validSelfMemberProfileUpdate(memberId))
          ));
        // Admins can remove any non-owner member; members can leave themselves (not if owner)
        allow delete: if isHouseholdAdmin(householdId)
          || isAppAdmin()
          || (isActiveHouseholdMember(householdId) && request.auth.uid == memberId && resource.data.role != "owner");
      }

      match /joinRequests/{requestId} {
        allow read: if isHouseholdAdmin(householdId) || (signedIn() && request.auth.uid == requestId);
        allow create: if signedIn()
          && request.auth.uid == requestId
          && validJoinRequest(requestId)
          && request.resource.data.status == "pending"
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);
        allow update: if isHouseholdAdmin(householdId)
          && validJoinRequest(requestId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.label == resource.data.label
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.photoURL == resource.data.photoURL
          && request.resource.data.avatarColor == resource.data.avatarColor
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ["approved", "rejected"]
          && validTimestamp(request.resource.data.reviewedAt)
          && request.resource.data.reviewedBy == request.auth.uid;
        // Allow the requester to delete their own request (withdraw pending, clear rejection to re-request)
        allow delete: if isHouseholdAdmin(householdId)
          || (signedIn() && request.auth.uid == requestId);
      }

      match /months/{monthKey} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);

        match /accounts/{accountId} {
          allow read: if isActiveHouseholdMember(householdId);
          allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
        }

        match /uploads/{uploadId} {
          allow read: if isActiveHouseholdMember(householdId);
          allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
        }
      }

      match /payoff_plans/{planId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
      }

      match /meta/{docId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
      }

      match /activity/{activityId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow create: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
        allow update, delete: if false;
      }

      match /dashboard/{docId} {
        allow read: if isActiveHouseholdMember(householdId);
        allow write: if isActiveHouseholdMember(householdId) || isHouseholdOwnerFromRoot(householdId);
      }
    }
  }
}
