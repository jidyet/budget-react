# TrackToZero V2 controlled-beta build template (BETA-1 draft, updated BETA-2).
#
# This is a PREVIEW of the environment file a beta build needs - copy to
# .env.beta (gitignored, same as .env) and fill in with the real dedicated
# beta project's values once it exists. Do NOT fill in real values and
# commit them; do NOT point this at production budgetapp-c9306 values.
#
# BETA-2 implemented the code change this template used to warn was
# missing: assertTrackToZeroV2ProductionConfig (src/services/tracktozero/
# repositoryRuntime.js) now accepts a configurable allowedProjectId instead
# of only ever accepting the hardcoded TRACKTOZERO_V2_PRODUCTION_PROJECT_ID
# ("budgetapp-c9306") - real production builds are unaffected (the constant
# is still the default when this env var is unset). Set
# VITE_TRACKTOZERO_V2_ALLOWED_PROJECT_ID below to the beta project's own id
# so firebaseProduction mode's fail-closed check expects THAT project,
# never silently accepting production's id or any other.
#
# Use with: vite build --mode beta / vite --mode beta (a "build:beta"/
# "dev:beta" npm script does not exist yet either - add one alongside the
# real beta project setup, mirroring dev:v2-local's pattern).

# --- Firebase project this build talks to (PENDING OWNER APPROVAL) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must exactly match VITE_FIREBASE_PROJECT_ID above - this is the
# fail-closed guard's expected project id for THIS build only.
VITE_TRACKTOZERO_V2_ALLOWED_PROJECT_ID=

# --- TrackToZero V2 runtime mode ---
# firebaseProduction is what a real (non-emulator) beta build uses - the
# same mode true production uses. There is currently no separate "beta"
# repository mode; the beta/production distinction lives entirely in WHICH
# Firebase project the above config points at, plus (once implemented) the
# environment-label flag below.
VITE_TRACKTOZERO_V2_REPOSITORY_MODE=

# --- Feature flags relevant to a controlled beta ---
VITE_TRACKTOZERO_V2_ENABLED=true
VITE_TRACKTOZERO_MIGRATION_ENABLED=false

# --- Environment label (NOT YET IMPLEMENTED - see BETA-1 report Section 22) ---
# Proposed: a small, explicit label so the app can show a restrained "Beta"
# badge and, if ever needed, distinguish beta from true production without
# guessing from the project id. Design only; not wired into any component
# yet - deferred again in BETA-2 since it's cosmetic, not a deploy blocker.
# VITE_TRACKTOZERO_V2_ENVIRONMENT_LABEL=beta
